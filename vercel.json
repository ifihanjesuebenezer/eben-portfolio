{
  "cleanUrls": true,
  "trailingSlash": false,
  "installCommand": "echo 'static site: nothing to install'",
  "buildCommand": "echo 'static site: pages are prebuilt by scripts/build.py'",
  "outputDirectory": ".",
  "headers": [
    { "source": "/assets/(img|fonts|vendor)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*).html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
